# Copy to docker/docker-compose.override.yml (gitignored) for local tweaks
# — e.g. exposing Postgres on the host for a GUI client, or mounting the
# backend source for iterative development against the built image.
#
#   cp docker/docker-compose.override.yml.example docker/docker-compose.override.yml
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml up

services:
  db:
    ports:
      - "5432:5432"
