# Single canonical environment file for every deployment target (Docker,
# Fly.io, Railway, bare-metal) — see docs/plan.md § Docker Packaging for why
# the original app's fork had two drifting .env files and this doesn't.
#
# Copy to .env and fill in the values below. Never commit the real file.

# --- Core ---
APP_ENV=production
BASE_URL=http://localhost:8000
# Generate: openssl rand -hex 32
SECRET_KEY=changeme-generate-a-random-secret
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=changeme-generate-a-random-fernet-key

# --- Database (PostgreSQL is the only CI-tested/supported target — see
# docs/adr/0002-postgres-primary-sqlite-best-effort.md) ---
# Plain postgres:// or postgresql:// URLs (as PaaS providers hand out) are
# rewritten to postgresql+asyncpg:// automatically.
DATABASE_URL=postgresql+asyncpg://stellar:changeme@db:5432/stellar
POSTGRES_PASSWORD=changeme

# --- GitHub OAuth ---
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: ${BASE_URL}/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=read:user

# --- Cache / rate limiting ---
# The star cache is always stored in Postgres; CACHE_BACKEND is currently
# ignored. Keep RATE_LIMIT_STORAGE_URI at memory://: Redis isn't supported
# yet, and a redis:// value stops the app from starting (see
# docs/deployment/docker.md § Redis).
CACHE_BACKEND=db
RATE_LIMIT_STORAGE_URI=memory://

# --- Reverse proxy ---
# Trust X-Forwarded-For from your proxy so rate limiting sees real client
# IPs. Needed behind Docker networking or a PaaS proxy (Render, Fly.io,
# Railway); not needed when a proxy on the same host forwards to
# 127.0.0.1. Only use * if the app port isn't reachable except through
# the proxy.
# FORWARDED_ALLOW_IPS=*

# --- Cookies ---
SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_DOMAIN=stellar.example.com
SESSION_LIFETIME_DAYS=30

# --- Sync tuning ---
STAR_CACHE_TTL_HOURS=4
SCHEDULER_ENABLED=true
